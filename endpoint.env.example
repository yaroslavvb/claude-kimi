# ~/.config/claude-kimi/endpoint.env -- chmod 600, never commit the filled-in copy.
# The raw Kimi K3 endpoint on Modal (SGLang; serves /v1/messages) and its Modal proxy-auth token pair
# (Modal dashboard -> Settings -> Proxy Auth Tokens). No /v1 suffix: Claude Code appends /v1/messages.
KIMI_BASE_URL=https://<workspace>--<endpoint>.us-west.modal.direct
MODAL_KEY=wk-...
MODAL_SECRET=ws-...
